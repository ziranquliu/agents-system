# 统一 UTF-8 编码声明
* text=auto encoding=UTF-8

# 源代码文件
*.py    text diff=python
*.js    text
*.ts    text
*.tsx   text
*.json  text
*.yaml  text
*.yml   text

# 文档文件
*.md    text
*.html  text
*.css   text

# 配置文件
*.env   text
*.toml  text
*.ini   text
Makefile text
Dockerfile text

# 二进制文件保持不变
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text
*.woff  binary
*.woff2 binary
*.eot   binary
