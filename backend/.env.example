# 本地智能体管理系统 - 开发环境配置
# 复制此文件为 .env 后修改

# 应用
ENVIRONMENT=development

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://agent:agent_dev_2024@localhost:5432/agent_system

# Redis
REDIS_URL=redis://:agent_dev_2024@localhost:6379/0

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# MinIO 对象存储 (开发环境使用本地文件系统，生产部署时配置)
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=agent_admin
# MINIO_SECRET_KEY=agent_dev_2024
STORAGE_BACKEND=local

# JWT 密钥 (生产环境务必修改)
SECRET_KEY=change-this-in-production
JWT_EXPIRATION_MINUTES=1440
