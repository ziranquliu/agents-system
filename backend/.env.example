# ============================================================
# 本地智能体管理系统 - 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并按需修改:
#   cp .env.example .env
# 注意: 生产环境部署前必须修改所有密码, 并配置强 SECRET_KEY。

# ============================================================
# 运行环境
# ============================================================
ENVIRONMENT=development  # development | staging | production

# ============================================================
# 数据库 (PostgreSQL 17)
# ============================================================
# 默认密码与 docker/docker-compose.dev.yml 一致(agent_pass_2024);
# 生产环境请改用强密码, 并同步 docker compose 环境变量 POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://agent:agent_pass_2024@localhost:5432/agent_system

# ============================================================
# Redis 7
# ============================================================
REDIS_URL=redis://:agent_pass_2024@localhost:6379/0

# ============================================================
# Qdrant (向量数据库)
# ============================================================
QDRANT_URL=http://localhost:6333

# ============================================================
# 存储
# ============================================================
STORAGE_BACKEND=local        # local | minio | s3
STORAGE_LOCAL_PATH=../data/storage

# ============================================================
# JWT 认证
# ============================================================
# 生产环境必须设置足够长的随机字符串:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时: 开发/测试环境自动生成(重启后失效), 生产环境将拒绝启动。
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440  # 24 小时
REFRESH_TOKEN_ENABLED=false
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================================
# 密码策略
# ============================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HASH_ITERATIONS=100000

# ============================================================
# 登录安全
# ============================================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOKEN_BLACKLIST_ENABLED=true

# ============================================================
# CORS
# ============================================================
# 多个用逗号分隔，如: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ============================================================
# 安全响应头
# ============================================================
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=false
# SECURITY_CSP_POLICY=default-src 'self'

# ============================================================
# 限流
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=10/minute

# ============================================================
# LLM 提供商
# ============================================================
MODEL_PROVIDERS=["openai","ollama","openrouter"]
